# Local dev: docker-compose maps postgres to host port 5433 (5432 is often
# already taken by another local project's Postgres).
DATABASE_URL="postgresql://fpl:fpl@localhost:5433/fpl_ai_picker"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

OPENROUTER_API_KEY=""
# Comma-separated fallback chain, tried in order. Verify current free-tier
# model IDs at https://openrouter.ai/models?max_price=0 before deploying —
# free-tier availability rotates. Leave unset to use the defaults in
# src/lib/openrouter.ts.
OPENROUTER_MODELS=""
