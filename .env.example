# Local dev: docker-compose maps postgres to host port 5433 (5432 is often
# already taken by another local project's Postgres).
DATABASE_URL="postgresql://fpl:fpl@localhost:5433/fpl_ai_picker"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

OPENROUTER_API_KEY=""
# Comma-separated fallback chain, tried in order. Verify current free-tier
# model IDs at https://openrouter.ai/models?max_price=0 before deploying —
# free-tier availability rotates. Leave unset to use the defaults in
# src/lib/openrouter.ts.
OPENROUTER_MODELS=""

# ZeptoMail transactional email (https://zeptomail.zoho.com).
# Token format: "Zoho-enczapikey <key>"
ZEPTO_MAIL_TOKEN=""
SENDER_ADDRESS="noreply@yourdomain.com"

# Web push (deadline reminders). Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# and reuse the same pair forever — regenerating invalidates every existing
# browser subscription. NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value
# as VAPID_PUBLIC_KEY — the public key is meant to be public (the browser
# needs it to create a subscription), the private key never is.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourdomain.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

