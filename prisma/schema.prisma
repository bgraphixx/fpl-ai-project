generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SquadSource {
  auto
  manual
}

enum RecommendationMode {
  xi
  transfer
  build
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fplTeamId    Int?
  fplTeamName  String?
  createdAt    DateTime @default(now())

  squadSnapshots  SquadSnapshot[]
  recommendations Recommendation[]
}

model SquadSnapshot {
  id         String      @id @default(cuid())
  userId     String
  gameweek   Int
  players    Json
  bank       Decimal     @db.Decimal(4, 1)
  teamValue  Decimal     @db.Decimal(4, 1)
  source     SquadSource
  createdAt  DateTime    @default(now())

  // Live scoring as of this snapshot (only populated for source "auto" —
  // manual edits don't have real FPL-scored points). Null until refreshed.
  points        Int?
  totalPoints   Int?
  rank          Int?
  pointsOnBench Int?
  transferCost  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameweek])
  @@index([userId, createdAt])
}

model Recommendation {
  id           String             @id @default(cuid())
  userId       String
  gameweek     Int
  mode         RecommendationMode
  inputSignals Json
  modelUsed    String
  summary      Json
  detail       Json
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameweek])
}

model FplCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime
}

model PlayerHistory {
  id                    Int      @id // FPL element ID
  pastSeasonMinutes     Int
  pastSeasonStarts      Int
  pastSeasonXG          Decimal  @db.Decimal(5, 2)
  pastSeasonXA          Decimal  @db.Decimal(5, 2)
  pastSeasonXGC         Decimal  @db.Decimal(5, 2)
  pastSeasonXGI         Decimal  @db.Decimal(5, 2)
  pastSeasonSaves       Int
  pastSeasonBPS         Int
  syncedAt              DateTime @default(now())
}

model TeamStrength {
  id                    Int      @id // FPL team ID
  strengthAttackHome    Int
  strengthAttackAway    Int
  strengthDefenseHome   Int
  strengthDefenseAway   Int
  syncedAt              DateTime @default(now())
}
