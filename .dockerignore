# =============================================================================
# .dockerignore — keep Docker build context small and secure
# =============================================================================

# Version control
.git
.gitignore

# Dependencies (reinstalled inside the container via `npm ci`)
node_modules

# Next.js build output (rebuilt inside the container)
.next
out

# Environment & secrets (injected at runtime, never baked into images)
.env*
!.env.example

# Docker files (no need to COPY themselves)
Dockerfile
docker-compose*.yml
.dockerignore

# IDE / Editor config
.vscode
.idea
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS metadata
.DS_Store
**/.DS_Store
Thumbs.db

# Documentation & reference (not needed at runtime)
README.md
AGENTS.md
CLAUDE.md
Reference/
LICENSE

# CI / CD
.github
.gitlab-ci.yml

# Testing & coverage
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Keys & certs (should never be in images)
*.pem
*.key
*.crt

# TypeScript build info (regenerated during build)
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel
